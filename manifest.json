{
  "manifest_version": 3,
  "name": "Blunder Lab: chess game review",
  "short_name": "Blunder Lab",
  "version": "1.8.3",
  "description": "Reviews your chess.com games with Stockfish: move ratings, puzzles from your own mistakes, an opening trainer and a rating forecast.",
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "host_permissions": ["https://api.chess.com/*", "https://api.github.com/*", "https://gist.githubusercontent.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Blunder Lab", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
